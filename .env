# Public site URL. Needed for sitemap, canonicals, and Google.
NEXT_PUBLIC_SITE_URL=https://events-on.com

# Google Search Console HTML tag content value (optional).
GOOGLE_SITE_VERIFICATION=

# Optional. The contact form now saves into the dashboard inbox.
NEXT_PUBLIC_FORM=

# Demo contact — replace from /admin/settings when the studio numbers are in.
NEXT_PUBLIC_WHATSAPP=201012345678
NEXT_PUBLIC_EMAIL=hello@eventson.com
NEXT_PUBLIC_INSTAGRAM=https://www.instagram.com/eventson
NEXT_PUBLIC_LINKEDIN=https://www.linkedin.com/company/eventson
NEXT_PUBLIC_FACEBOOK=https://www.facebook.com/eventson
NEXT_PUBLIC_TIKTOK=https://www.tiktok.com/@eventson
NEXT_PUBLIC_YOUTUBE=https://www.youtube.com/@eventson

# Dashboard login (required to open /admin)
ADMIN_EMAIL=studio@eventson.com
ADMIN_PASSWORD=eventson-admin

# Optional signing secret for the admin cookie. Falls back to ADMIN_PASSWORD.
ADMIN_SECRET=
